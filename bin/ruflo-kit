#!/usr/bin/env bash
# ============================================================================
# ruflo-kit — single entrypoint for the ruflo + Agentic QE setup/repair kit.
#
# Clone this repo once, then run it against ANY codebase path:
#
#   bin/ruflo-kit setup       /path/to/codebase     # fresh machine → proved stack (install+init+heal+proof)
#   bin/ruflo-kit adopt       /path/to/codebase     # snapshot → setup → preservation receipt (never --force)
#   bin/ruflo-kit snapshot    /path/to/codebase     # WAL-safe backup + row-count manifest of learning stores
#   bin/ruflo-kit status      /path/to/codebase     # one-screen truth (disk-derived; --json; --forensics)
#   bin/ruflo-kit sync        /path/to/codebase     # one-verb heal (fix cascade; --dry-run)
#   bin/ruflo-kit proof       /path/to/codebase     # 15-probe disk-evidence proof, run twice (x2)
#   bin/ruflo-kit init        /path/to/codebase     # first-time bootstrap
#   bin/ruflo-kit session     /path/to/codebase     # per-session maintenance
#   bin/ruflo-kit health      /path/to/codebase     # growth-delta health check
#   bin/ruflo-kit fix-ruflo   /path/to/codebase     # repair ruflo MCP/AgentDB
#   bin/ruflo-kit fix-aqe     /path/to/codebase     # codify AQE hardening
#   bin/ruflo-kit fix-brain   /path/to/codebase     # register ruvnet-brain MCP server
#   bin/ruflo-kit fix-statusbar /path/to/codebase   # restore the statusline
#   bin/ruflo-kit upgrade     /path/to/codebase     # major ruflo version bump
#   bin/ruflo-kit verify-learning /path/to/codebase # read-only loop liveness (CI exit 1 if hollow)
#   bin/ruflo-kit fix-learning /path/to/codebase    # populate/unlock a hollow learning loop
#   bin/ruflo-kit bench       /path/to/codebase     # self-improvement bench (read-only)
#   bin/ruflo-kit harvest     /path/to/codebase     # replay AQE experiences
#   bin/ruflo-kit embed-sweep /path/to/codebase     # backfill lost capture vectors
#   bin/ruflo-kit version                           # kit + ruflo + aqe versions
#   bin/ruflo-kit self-update                       # git pull the kit clone
#
# The target path is optional and defaults to $RUFLO_KIT_TARGET, else $(pwd).
# Flags (--dry-run/--force/--reactivate) may appear before or after the path.
# Every verb accepts -h/--help and NEVER performs its work when given it — see
# _kit_has_help_flag below. `ruflo-kit help <verb>` is also accepted and shows
# that verb's own usage. A target that does not already exist requires an
# absolute path or --new-target (only meaningful for setup/init) — a typo or
# a bare word like "help" is refused, never silently turned into a new
# project — see _kit_check_target_exists below.
# ============================================================================
set -uo pipefail

# ── Pipe-safety for every kit child process (VERB-SAFETY-V1, B7 DEFECT 1b) ──
# Field incident: `ruflo-kit upgrade --help | head -50` truncated output, the
# reader (`head`) closed its end early, and the still-writing `npm install`
# (mid native build) was killed outright by SIGPIPE — leaving a broken global
# package that had to be manually repaired. This kit already hit the sibling
# failure mode once (commit 3cff08e: under `pipefail`, an early-exiting
# `grep -q` SIGPIPEd a `pgrep` earlier in the same pipeline and inverted a
# FOUND daemon to "none"). Ignoring SIGPIPE here means a downstream reader
# closing early turns into an ordinary EPIPE write() error for any child this
# process execs or forks — which well-behaved CLIs (npm, git, curl, sqlite3)
# already check and handle gracefully — instead of an asynchronous, uncatchable
# kill mid-write. SIG_IGN (unlike a trap function) survives exec(), so this
# protects `exec bash lib/<verb>.sh` and everything IT forks too, without
# touching any lib/*.sh.
trap '' PIPE

# Resolve KIT_DIR through symlinks so a global `ruflo-kit` on PATH (a symlink
# into the real clone) still finds lib/ assets/ tools/. macOS bash 3.2 has no
# `readlink -f`, so walk the link chain by hand (no GNU coreutils dependency).
_kit_resolve_dir() {
  local src="$1" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" 2>/dev/null && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" 2>/dev/null && pwd
}
KIT_DIR="$(cd "$(_kit_resolve_dir "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"

usage() {
  sed -n '2,/^# ===/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; s/^=.*//'
  cat <<EOF

Commands:
  setup          Fresh machine → proved working stack: install + init + heal + proof; --with-brain-kb
  adopt          Adopt an existing codebase: snapshot → setup (never --force) → machine-verified
                 preservation receipt (MEMORY-PRESERVE-PROOF-V1); --verify-only re-checks the diff
  snapshot       WAL-safe backup + per-table row-count manifest of the learning stores; --dry-run
  status         One-screen truth (versions, sentinels, daemon, learning); --json;
                 --forensics appends a read-only manual-install evidence report
                 (plain-text only — --json ignores it)
  sync           One-verb heal — run the fix cascade in order; --dry-run
  init           First-time bootstrap of a codebase (ruflo + AQE + AgentDB)
  session        Per-session maintenance (patches, daemon, verification)
  health         Growth-delta health check (CI-friendly exit code)
  proof          15-probe disk-evidence proof, run twice (x2) — exit 0 only when PROVED
  fix-ruflo      Diagnose + repair the ruflo / claude-flow MCP + AgentDB setup
  fix-aqe        Codify AQE-side hardening + install .claude helpers/commands
  fix-brain      Register the vendored ruvnet-brain search_ruvnet MCP server (MCP-only; --download to fetch the KB)
  dashboard      On-demand local web dashboard (foreground, read-only, 127.0.0.1; --port N; Ctrl-C stops)
  fix-statusbar  Restore the rich ruflo + Agentic QE v3 statusline
  upgrade        Major-version ruflo migration (stop daemon, bump, re-activate)
  verify-learning Read-only learning-loop liveness probes (CI-friendly exit code)
  fix-learning   Populate + unlock a hollow self-learning loop (idempotent, --dry-run)
  bench          Run the self-improvement bench (read-only)
  harvest        Replay AQE experiences into the ruflo substrate
  embed-sweep    Backfill capture vectors the hook lost (opt-in, --dry-run)
  version        Show kit git sha + detected ruflo / agentic-qe versions
  self-update    git pull the kit clone (fast-forward only)
  help [verb]    Show this help, or a specific verb's usage (e.g. help sync)

Run a command with -h/--help for its own usage, flags, and whether it mutates
the target / starts processes / costs money — it is answered directly by this
dispatcher and never runs the command's actual work. Docs: $KIT_DIR/docs/
EOF
}

# ── Verb safety (VERB-SAFETY-V1, B7 DEFECT 1a) ──────────────────────────────
# lib/common.sh's kit_resolve() parses -h/--help into KIT_WANT_HELP, but only
# THREE of the ~18 lib/*.sh scripts (adopt.sh, init.sh, snapshot.sh) actually
# check that flag before doing real work — every other verb (upgrade, setup,
# sync, fix-*, session, health, ...) silently ignores it and runs to
# completion. Field incident: a teammate ran `ruflo-kit upgrade --help` to
# learn the flags; upgrade.sh never looks at KIT_WANT_HELP, so it executed
# Phase A — a full global `npm install -g ruflo` — instead of printing help.
#
# Rather than patch KIT_WANT_HELP-checking into N lib scripts (and every
# future one), the fix lives ONCE at the single chokepoint every verb passes
# through: this dispatcher. Each case arm below checks for -h/--help BEFORE
# exec'ing/sourcing its lib/*.sh — so a help request is honored regardless of
# whether the target script itself would have honored it.
_kit_has_help_flag() {
  local a
  for a in "$@"; do
    case "$a" in -h|--help) return 0 ;; esac
  done
  return 1
}

# ── Target-resolution safety (VERB-SAFETY-V1 round 2, B7b) ─────────────────
# Field incident: something of the shape `<verb> help` (e.g. `init help`,
# `sync help` — a critic asking "what does this verb do" the way many CLIs
# accept `tool subcommand help`) was NOT a recognized -h/--help token (round
# 1 only catches exact -h/--help), so lib/common.sh's kit_resolve() did what
# it always does with an unrecognized bare word: silently accepted it AS THE
# TARGET PATH. For `init`/`setup` — the only two verbs without a kit_require_
# target guard, because they are meant to bootstrap a codebase that may not
# have the tooling yet — that target then got a REAL project tree written
# into it: `./help/` appeared with .agentic-qe/, .claude/, .claude-flow/,
# .swarm/, .mcp.json, agentdb.db, ruvector.db. Reproduced live in a sandbox:
# `ruflo-kit init help` resolves "target: <cwd>/help" and — confirmed
# separately — lib/init.sh unconditionally `mkdir -p`s that path BEFORE its
# own --dry-run gate, so even a dry-run physically creates the directory.
#
# This is DEFECT 1's shape generalized past -h/--help: ANY bare word that
# happens not to already exist as a directory is, to kit_resolve, indistin-
# guishable from a deliberately-typed new-project path. Rather than guess
# every reserved/ambiguous word (help, version, status, a stray -v, a lone
# "-", ...) one at a time, the fix is structural: a target that does not
# already exist requires an explicit, unambiguous opt-in — an ABSOLUTE path,
# or (for the two verbs actually designed to create a new target) the
# explicit --new-target flag. Everything else refuses with a clear message
# instead of silently bootstrapping a phantom project. This mirrors (does not
# call — the dispatcher does not source common.sh, see the kit self-audit's
# F9.7 duplication note) kit_resolve's own flag-recognition set exactly, so
# it never disagrees with what the real script would have picked as target.
_kit_first_positional() {
  local a
  for a in "$@"; do
    case "$a" in
      --dry-run|--force|--reactivate|--json|-h|--help) ;;
      --*) ;;
      *) [[ -n "$a" ]] && { printf '%s' "$a"; return 0; } ;;
    esac
  done
  return 1
}

_kit_is_known_verb() {
  case "$1" in
    setup|adopt|snapshot|status|sync|proof|init|fix-ruflo|fix-aqe|fix-brain| \
    fix-statusbar|dashboard|session|session-init|health|upgrade| \
    verify-learning|fix-learning|bench|harvest|embed-sweep|version|self-update) return 0 ;;
    *) return 1 ;;
  esac
}

# _kit_target_exists_or_refuse <verb> <allow-new 0|1> <candidate> "$@" — the
# VALIDATION rule, split from candidate DERIVATION (which differs by verb —
# see below) so there is exactly one implementation of "is this target
# acceptable" regardless of which verb's argument shape produced it.
# <candidate> is the resolved target string, ALWAYS an absolute default (cwd
# or $RUFLO_KIT_TARGET) when the caller found no explicit positional arg —
# never empty. Exit 0 = safe to proceed, 1 = refused (caller must exit 1).
_kit_target_exists_or_refuse() {
  local verb="$1" allow_new="$2" tgt="$3"; shift 3
  case "$tgt" in /*) return 0 ;; esac                          # absolute path (incl. resolved defaults): always allowed
  local abs; abs="$(pwd)/$tgt"
  [[ -d "$abs" ]] && return 0                                  # already exists: no opt-in needed
  if [[ "$allow_new" -eq 1 ]]; then
    local a; for a in "$@"; do [[ "$a" == "--new-target" ]] && return 0; done
  fi
  echo "ruflo-kit $verb: target '$tgt' does not exist as a directory." >&2
  if [[ "$allow_new" -eq 1 ]]; then
    echo "  To create a NEW project there, pass an absolute path or add --new-target." >&2
  else
    echo "  '$verb' operates on an EXISTING codebase and never creates one — check the path." >&2
  fi
  echo "  If you meant to ask for help instead: ruflo-kit help $verb   or   ruflo-kit $verb --help" >&2
  return 1
}

# _kit_check_target_exists <verb> <allow-new 0|1> "$@" — for every verb that
# goes through kit_resolve's multi-arg scan (_kit_first_positional above).
# allow-new=1 only for setup/init (the two verbs documented to bootstrap a
# brand-new target); every other verb operates on an EXISTING codebase.
_kit_check_target_exists() {
  local verb="$1" allow_new="$2"; shift 2
  local tgt; tgt="$(_kit_first_positional "$@")" || tgt="${RUFLO_KIT_TARGET:-$(pwd)}"
  _kit_target_exists_or_refuse "$verb" "$allow_new" "$tgt" "$@"
}

# ── First-arg-only verbs: bench/dashboard/harvest (VERB-SAFETY-V1 round 3) ──
# These three bypass kit_resolve entirely (they cd into the target, then exec
# a node tool — see the case arms below) and have their OWN, much simpler
# resolution rule, already written inline at each call site before round 2:
# "$1 is the target IFF it doesn't look like a flag; otherwise default to
# $RUFLO_KIT_TARGET/cwd". Round-2's guard used the kit_resolve-style multi-arg
# SCAN for these too, which finds the first non-flag token ANYWHERE in the
# args — wrong for these verbs, because their real resolver never looks past
# $1. `dashboard --port 3939 .` has non-flag token "3939" (dashboard.cjs's own
# `process.argv.indexOf('--port')` consumes it as the port value, scanning
# the WHOLE argv rather than a positional walk) sitting where the scan expects
# a target, so it was misread as the target and refused — a false positive
# that broke a previously-working invocation (round-3 critic finding).
#
# Fix: give these three verbs their own candidate-DERIVATION that mirrors
# their real one-line rule exactly, expressed as ONE predicate function that
# BOTH the guard and the actual cd-target/shift logic call — not a second,
# separately-maintained list of "which flags take a value" (that list would
# need updating every time bench/dashboard/harvest grows a new flag, and
# forgetting to update it is exactly how this regression happened). Because
# the real resolution call sites below now call this same predicate instead
# of re-deriving it inline, the guard and the actual behavior cannot diverge.
_kit_firstarg_is_target() { [[ $# -gt 0 && "$1" != --* ]]; }
_kit_firstarg_resolve() {
  if _kit_firstarg_is_target "$@"; then printf '%s' "$1"
  else printf '%s' "${RUFLO_KIT_TARGET:-$(pwd)}"
  fi
}
_kit_check_target_exists_firstarg() {
  local verb="$1" allow_new="$2"; shift 2
  local tgt; tgt="$(_kit_firstarg_resolve "$@")"
  _kit_target_exists_or_refuse "$verb" "$allow_new" "$tgt" "$@"
}

# _kit_dispatcher_divergent_path <resolved-target> "$@" — WAVE 5 / B20. The
# ONE predicate: bench/dashboard/harvest resolve via _kit_firstarg_resolve,
# which ONLY ever looks at $1 (round-3 comment above). If $1 is flag-shaped,
# resolution falls back to cwd/$RUFLO_KIT_TARGET even when a later argument
# is a real, existing directory the user plainly meant as the target (the
# confirmed B14 gap: aqe-harvest.cjs/selfimprove-bench.cjs never see the
# user's original argv, only the already-resolved cwd, so they cannot detect
# this themselves). The dispatcher is the only place holding BOTH the
# original argv and the resolved target at once — call this AFTER
# <resolved-target> is computed; it only OBSERVES that pairing and prints
# nothing itself. Nothing it finds is returned into resolution: neither
# caller below feeds its output back into `t`, the shift, or the cd target —
# this is read-only, so it cannot reintroduce the multi-arg-scan-as-
# resolution mistake (the `--port 3939` false positive) that made round 3's
# guard diverge from actual behavior. On a match, echoes the diverging path
# and returns 0; otherwise returns 1 with no output — callers below decide
# separately what a match MEANS (warn vs refuse), but never what it IS.
_kit_dispatcher_divergent_path() {
  local tgt="$1"; shift
  _kit_firstarg_is_target "$@" && return 1    # target-first: nothing to diverge from
  local tgt_real; tgt_real="$(cd "$tgt" 2>/dev/null && pwd -P)" || tgt_real="$tgt"
  local a a_real
  for a in "$@"; do
    case "$a" in --*) continue ;; esac        # flag tokens are never target candidates
    a_real="$(cd "$a" 2>/dev/null && pwd -P)" || continue   # not an existing dir: no claim to make
    [[ "$a_real" == "$tgt_real" ]] && continue              # same directory as resolved target: no divergence
    printf '%s' "$a"
    return 0
  done
  return 1
}

# _kit_notice_dispatcher_divergence <verb> <resolved-target> "$@" — for the
# READ-ONLY verb (dashboard): report on stderr, never block. dashboard is
# foreground/interactive/127.0.0.1-only and ALREADY prints its resolved
# target unconditionally on STDOUT in its own "listening on" banner
# (tools/dashboard.cjs), so there is no silent-mutation risk here for a
# `2>/dev/null` caller to fall into — worst case is a harmless wrong (but
# still self-reported) display. This is why dashboard gets a notice and not
# the refusal below.
_kit_notice_dispatcher_divergence() {
  local verb="$1" tgt="$2"; shift 2
  local other; other="$(_kit_dispatcher_divergent_path "$tgt" "$@")" || return 0
  echo "ruflo-kit $verb: note — '$other' is an existing directory but was NOT treated as the target (resolved target: '$tgt'); only the first argument is checked. Put it first if that's what you meant." >&2
}

# _kit_refuse_on_dispatcher_divergence <verb> <resolved-target> "$@" — for
# the MUTATING verbs (bench, harvest), whose real work WRITES into
# <resolved-target>'s stores (bench: .claude-flow/selfimprove-history.jsonl;
# harvest: .swarm/lora-weights.json, agentdb.db, .swarm/harvest-state.json).
# Escalation (B14's critic, round 2): a stderr-only notice protects an
# interactive user twice but gives a `2>/dev/null` / stdout-only CI consumer
# ZERO protection — the notice is discarded and the mutation still happens
# underneath it. A divergence for these two verbs means "the user pointed at
# X, we are about to WRITE to Y" — not a warning worth proceeding past, a
# mistake worth stopping. Exits nonzero, which a discarded stderr stream
# cannot hide, before any cd/exec — no work happens, so nothing is written
# to the wrong project. Uses the exact same predicate as the notice above,
# so refusal can never disagree with what would have been reported; the
# escape hatch (rerun with the real target first) is spelled out in the
# message itself. Caller MUST do `... || exit 1`.
_kit_refuse_on_dispatcher_divergence() {
  local verb="$1" tgt="$2"; shift 2
  local other; other="$(_kit_dispatcher_divergent_path "$tgt" "$@")" || return 0
  echo "ruflo-kit $verb: refused — '$other' is an existing directory but was NOT treated as the target (only the first argument is checked)." >&2
  echo "  '$verb' WRITES to the resolved target ('$tgt'); a likely wrong-target mismatch is not run automatically." >&2
  echo "  If '$tgt' is really what you meant, rerun without any other existing-directory argument (or pass it explicitly first)." >&2
  echo "  If you meant '$other', put it FIRST:  ruflo-kit $verb $other [flags...]" >&2
  return 1
}

# Per-verb usage: what it does, its flags, and the two facts an operator most
# needs before running something unfamiliar — does it MUTATE the target, and
# can it START PROCESSES / cost money (network, native builds, LLM calls).
_kit_verb_help() {
  case "$1" in
    setup) cat <<'EOF'
Usage: ruflo-kit setup <target> [--with-brain-kb] [--refresh-brain-kb] [--skip-install] [--json] [--dry-run] [--new-target]

  Fresh machine -> proved working stack, one verb: prereqs -> global installs
  -> init -> heal (sync) -> optional brain KB -> proof (x2). Idempotent — a
  second run on a healthy machine changes nothing. <target> must already
  exist as a directory UNLESS it is an absolute path or --new-target is
  given — a nonexistent relative target is refused rather than silently
  bootstrapped (a typo or a bare word like "help" must never create a
  phantom project).
  Mutates target:   YES (writes config/dotfiles into <target>; installs global
                    npm packages on the machine)
  Starts daemon:    NO — setup NEVER starts or stops the ruflo daemon
  Billed / network: installs + optional brain KB fetch need network; no
                    billed LLM calls
EOF
    ;;
    adopt) cat <<'EOF'
Usage: ruflo-kit adopt <target> [--dry-run] [--verify-only]

  snapshot (baseline) -> setup (NEVER --force) -> recount every baselined
  table -> preservation verdict PRESERVED / VIOLATED / NOT ASSESSABLE.
  Refuses --force outright — that guarantee is the point of this verb.
  --verify-only: just recount + diff against the existing baseline (no
  snapshot/setup run — safe to invoke any time).
  Mutates target:   YES (via setup), unless --verify-only (then read-only)
  Starts daemon:    NO
  Billed / network: same as setup, unless --verify-only (then none)
EOF
    ;;
    snapshot) cat <<'EOF'
Usage: ruflo-kit snapshot <target> [--dry-run]

  WAL-safe online backup + per-table row-count manifest of the learning
  stores (.swarm/memory.db, .agentic-qe/memory.db, agentdb.db, RVF
  artifacts), written OUTSIDE the target under ~/.ruflo-kit/backups/. Also
  writes a baseline pointer into <target>/.claude-flow/data/ for a later
  `adopt`. A store whose per-table counts cannot be read is reported LOUDLY
  (exit nonzero) — it is never written into the manifest as an empty "{}".
  Mutates target:   only <target>/.claude-flow/data/adoption-baseline.json
                    (a pointer file) — the live stores are opened read-only
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    status) cat <<'EOF'
Usage: ruflo-kit status <target> [--json] [--hints] [--forensics]

  One-screen disk-derived truth: versions, sentinels, daemon (via pgrep),
  MCP servers, learning-store liveness. --json is always valid JSON.
  --forensics appends a read-only manual-install evidence report (plain-text
  only — --json ignores it).
  Mutates target:   NO (fully read-only)
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    sync) cat <<'EOF'
Usage: ruflo-kit sync <target> [--dry-run]

  One-verb heal: runs the fix cascade in order (fix-ruflo -> fix-aqe ->
  fix-statusbar -> fix-brain -> verify-learning) and prints one summary
  table. Exit is nonzero only when a stage HARD-fails.
  Mutates target:   YES (whatever the fix stages individually do)
  Starts daemon:    NO
  Billed / network: installs may need network; no billed LLM calls
EOF
    ;;
    proof) cat <<'EOF'
Usage: ruflo-kit proof <target> [--single] [--json] [--dry-run]

  15-probe disk-evidence proof of the stack, run TWICE by default (env -i on
  pass 2) — exit 0 only when both passes agree PROVED. --single runs one
  pass.
  Mutates target:   mostly read-only; P8 exercises the statusLine command,
                    which can restore the statusline + append to its guard
                    log as a documented side effect
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    init) cat <<'EOF'
Usage: ruflo-kit init <target> [--force] [--reactivate] [--dry-run] [--new-target]

  First-time bootstrap of ruflo + Agentic QE + AgentDB in <target>.
  Idempotent by default (skips completed steps). --force re-inits
  EVERYTHING — DESTRUCTIVE to existing learning stores; prefer `adopt` for an
  existing codebase. --reactivate re-runs only activation + daemon policy.
  <target> must already exist as a directory UNLESS it is an absolute path
  or --new-target is given (init is the one verb genuinely meant to
  bootstrap a brand-new project) — a nonexistent relative target is
  otherwise refused, never silently created (field incident: `init help`
  wrote a full phantom project tree to ./help/).
  Mutates target:   YES; --force can RESET existing learning stores
  Starts daemon:    NO (only reports/policies it)
  Billed / network: installs may need network; no billed LLM calls
EOF
    ;;
    fix-ruflo) cat <<'EOF'
Usage: ruflo-kit fix-ruflo <target> [--dry-run]

  Diagnose + repair the ruflo / claude-flow MCP + AgentDB setup in <target>
  (version pins, sentinels, dist patches).
  Mutates target:   YES (config + dist patches)
  Starts daemon:    NO
  Billed / network: no billed LLM calls
EOF
    ;;
    fix-aqe) cat <<'EOF'
Usage: ruflo-kit fix-aqe <target> [--dry-run]

  Codify Agentic QE hardening + install .claude helpers/commands in <target>.
  Mutates target:   YES (.claude/ helpers, config)
  Starts daemon:    NO
  Billed / network: no billed LLM calls
EOF
    ;;
    fix-brain) cat <<'EOF'
Usage: ruflo-kit fix-brain <target> [--download] [--refresh] [--allow-unsigned] [--dry-run]

  Register the vendored ruvnet-brain search_ruvnet MCP server (MCP-only — no
  hooks/launchd/plugin install; zero always-on cost). --download fetches the
  Ed25519-verified KB; --refresh additionally replaces a stale KB in place.
  Neither download ever happens implicitly.
  Mutates target:   YES (.mcp.json entry); --download/--refresh also write
                    into the shared KB cache (~/.cache/ruvnet-brain/kb)
  Starts daemon:    NO
  Billed / network: --download/--refresh fetch a GB-class KB over the
                    network; no billed LLM calls
EOF
    ;;
    fix-statusbar) cat <<'EOF'
Usage: ruflo-kit fix-statusbar <target>

  Install/restore the ruflo + Agentic QE v3 statusline from the sha256-
  verified canonical source.
  Mutates target:   YES (.claude/helpers/statusline.cjs + settings.json)
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    dashboard) cat <<'EOF'
Usage: ruflo-kit dashboard <target> [--port N]

  On-demand LOCAL web dashboard: foreground only, dies on Ctrl-C, binds
  127.0.0.1 only, serves disk-derived truth. Never detaches, never installs
  launchd/cron.
  Mutates target:   NO (read-only; serves `status --json` + history files)
  Starts daemon:    NO — but DOES start a foreground local HTTP server for as
                    long as it runs (stopped by Ctrl-C, never backgrounded)
  Billed / network: NO (localhost only)
EOF
    ;;
    session|session-init) cat <<'EOF'
Usage: ruflo-kit session <target>

  Per-session maintenance: patches, daemon policy check, verification.
  Mutates target:   YES (whatever the maintenance steps apply)
  Starts daemon:    NO (policy-only, same contract as setup's S6)
  Billed / network: no billed LLM calls
EOF
    ;;
    health) cat <<'EOF'
Usage: ruflo-kit health <target> [--reset] [--dry-run] [--json]

  Growth-delta health check: diffs current state vs the last snapshot, then
  updates the snapshot. --reset force-rebaselines; --dry-run diffs without
  updating; --json emits the raw current snapshot only.
  Mutates target:   YES — writes/updates its own snapshot file, unless
                    --dry-run or --json (both report-only)
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    upgrade) cat <<'EOF'
Usage: ruflo-kit upgrade <target> [--dry-run]

  Major ruflo-version migration, Phase A: stops the daemon, snapshots npm
  caches, runs a REAL GLOBAL `npm install -g ruflo@latest` (native rebuilds
  included), then re-activates (fix-ruflo + init --reactivate). This is a
  long-running, network-dependent, MACHINE-WIDE mutation, not just a
  <target> one — close other Claude Code sessions first (it restarts the
  live MCP server). This help text is answered WITHOUT running any of that.
  Mutates target:   YES; ALSO mutates the MACHINE (global npm package)
  Starts daemon:    stops it if running; does not start it
  Billed / network: no billed LLM calls, but a real npm registry fetch + a
                    potentially slow native build
EOF
    ;;
    verify-learning) cat <<'EOF'
Usage: ruflo-kit verify-learning <target> [--json]

  Read-only learning-loop liveness probes (CI-friendly: nonzero exit if
  hollow).
  Mutates target:   NO
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    fix-learning) cat <<'EOF'
Usage: ruflo-kit fix-learning <target> [--dry-run] [--cleanup [--confirm]]

  Populate/unlock a hollow self-learning loop. --cleanup lists stray stores
  (dry by default); --cleanup --confirm removes them (backed up first).
  Mutates target:   YES, unless --dry-run or plain --cleanup (list-only)
  Starts daemon:    NO
  Billed / network: no billed LLM calls
EOF
    ;;
    bench) cat <<'EOF'
Usage: ruflo-kit bench <target> [args passed through to the bench tool]

  Self-improvement bench: a re-runnable, READ-ONLY longitudinal instrument
  that appends one row to .claude-flow/selfimprove-history.jsonl per run.
  Mutates target:   appends one history row; the measurement itself is
                    read-only against the stores/routers
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    embed-sweep) cat <<'EOF'
Usage: ruflo-kit embed-sweep <target> [--dry-run] [--limit N] [--json]

  Backfill captured_experiences.embedding for rows whose vector the capture
  hook LOST. agentic-qe's hook inserts the row, then fires an un-awaited embed
  wrapped in a bare catch{}; under load the subprocess exits first and the
  vector is gone. Upstream's compensator is itself fire-and-forget and capped
  at 200 per process boot, so rows accumulate indefinitely.

  Replays a DETERMINISTIC computation — same function, same text, same config
  as capture would have used — after an identity gate proves this host's
  embedder reproduces the store's existing vectors. Skips rows younger than
  60m (the capture path's own embed may still land), never overwrites an
  existing vector, and never writes the all-zero vector the embedder returns
  for non-semantic text.

  Does NOT repair the capture path. Probe #15 keeps reporting that fault, and
  subtracts kit-swept rows so this verb cannot launder its own verdict.

  Mutates target:   YES (.agentic-qe/memory.db embedding column only, plus a
                    .swarm/embed-sweep-state.json ledger; backs the DB up first)
  Starts daemon:    NO
  Billed / network: NO (model weights must already be cached)
EOF
    ;;
    harvest) cat <<'EOF'
Usage: ruflo-kit harvest <target> [args passed through to the harvest tool]

  Batch-replay AQE's recorded experiences into the ruflo substrate (SONA
  LoRA + AgentDB). Progress tracked in a writable .swarm/harvest-state.json
  ledger (idempotent).
  Mutates target:   YES (.swarm/lora-weights.json, agentdb.db, harvest-state
                    ledger) — the SOURCE experience DB stays read-only
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    version) cat <<'EOF'
Usage: ruflo-kit version

  Print the kit's git sha/date + detected global ruflo / agentic-qe versions.
  Mutates target:   NO (takes no target argument)
  Starts daemon:    NO
  Billed / network: NO
EOF
    ;;
    self-update) cat <<'EOF'
Usage: ruflo-kit self-update

  git pull (fast-forward only) the KIT'S OWN clone — never touches a target
  codebase.
  Mutates target:   NO target argument at all; mutates the KIT CLONE itself
  Starts daemon:    NO
  Billed / network: fetches from the kit's own git remote
EOF
    ;;
    *) echo "ruflo-kit $1: no dedicated help text yet — see 'ruflo-kit help'." ;;
  esac
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  setup)
    _kit_has_help_flag "$@" && { _kit_verb_help setup; exit 0; }
    _kit_check_target_exists setup 1 "$@" || exit 1
    exec bash "$KIT_DIR/lib/setup.sh"          "$@" ;;
  adopt)
    _kit_has_help_flag "$@" && { _kit_verb_help adopt; exit 0; }
    _kit_check_target_exists adopt 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/adopt.sh"          "$@" ;;
  snapshot)
    _kit_has_help_flag "$@" && { _kit_verb_help snapshot; exit 0; }
    _kit_check_target_exists snapshot 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/snapshot.sh"       "$@" ;;
  status)
    _kit_has_help_flag "$@" && { _kit_verb_help status; exit 0; }
    _kit_check_target_exists status 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/status.sh"         "$@" ;;
  sync)
    _kit_has_help_flag "$@" && { _kit_verb_help sync; exit 0; }
    _kit_check_target_exists sync 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/sync.sh"           "$@" ;;
  proof)
    _kit_has_help_flag "$@" && { _kit_verb_help proof; exit 0; }
    _kit_check_target_exists proof 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/proof.sh"          "$@" ;;
  init)
    _kit_has_help_flag "$@" && { _kit_verb_help init; exit 0; }
    _kit_check_target_exists init 1 "$@" || exit 1
    exec bash "$KIT_DIR/lib/init.sh"           "$@" ;;
  fix-ruflo)
    _kit_has_help_flag "$@" && { _kit_verb_help fix-ruflo; exit 0; }
    _kit_check_target_exists fix-ruflo 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/fix-ruflo.sh"      "$@" ;;
  fix-aqe)
    _kit_has_help_flag "$@" && { _kit_verb_help fix-aqe; exit 0; }
    _kit_check_target_exists fix-aqe 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/fix-aqe.sh"        "$@" ;;
  fix-brain)
    _kit_has_help_flag "$@" && { _kit_verb_help fix-brain; exit 0; }
    _kit_check_target_exists fix-brain 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/fix-brain.sh"      "$@" ;;
  fix-statusbar)
    _kit_has_help_flag "$@" && { _kit_verb_help fix-statusbar; exit 0; }
    _kit_check_target_exists fix-statusbar 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/fix-statusbar.sh"  "$@" ;;
  session|session-init)
    _kit_has_help_flag "$@" && { _kit_verb_help session; exit 0; }
    _kit_check_target_exists session 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/session-init.sh" "$@" ;;
  health)
    _kit_has_help_flag "$@" && { _kit_verb_help health; exit 0; }
    _kit_check_target_exists health 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/health.sh"         "$@" ;;
  upgrade)
    _kit_has_help_flag "$@" && { _kit_verb_help upgrade; exit 0; }
    _kit_check_target_exists upgrade 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/upgrade.sh"        "$@" ;;
  verify-learning)
    _kit_has_help_flag "$@" && { _kit_verb_help verify-learning; exit 0; }
    _kit_check_target_exists verify-learning 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/verify-learning.sh" "$@" ;;
  fix-learning)
    _kit_has_help_flag "$@" && { _kit_verb_help fix-learning; exit 0; }
    _kit_check_target_exists fix-learning 0 "$@" || exit 1
    exec bash "$KIT_DIR/lib/fix-learning.sh"   "$@" ;;
  bench)
    _kit_has_help_flag "$@" && { _kit_verb_help bench; exit 0; }
    _kit_check_target_exists_firstarg bench 0 "$@" || exit 1
    # tools/ operate on the target's runtime DBs via cwd → cd into the target.
    # Single resolution rule shared with the guard above (_kit_firstarg_*) —
    # see the round-3 comment there for why this isn't a duplicated flag list.
    t="$(_kit_firstarg_resolve "$@")"
    _kit_refuse_on_dispatcher_divergence bench "$t" "$@" || exit 1
    _kit_firstarg_is_target "$@" && shift
    ( cd "$t" 2>/dev/null || cd "$(pwd)"; exec node "$KIT_DIR/tools/selfimprove-bench.cjs" "$@" ) ;;
  dashboard)
    _kit_has_help_flag "$@" && { _kit_verb_help dashboard; exit 0; }
    _kit_check_target_exists_firstarg dashboard 0 "$@" || exit 1
    # On-demand LOCAL dashboard (DASHBOARD-V1): foreground, read-only,
    # 127.0.0.1-only, Ctrl-C to stop. Never detaches, never billed.
    t="$(_kit_firstarg_resolve "$@")"
    _kit_notice_dispatcher_divergence dashboard "$t" "$@"
    _kit_firstarg_is_target "$@" && shift
    ( cd "$t" 2>/dev/null || cd "$(pwd)"; exec node "$KIT_DIR/tools/dashboard.cjs" "$@" ) ;;
  harvest)
    _kit_has_help_flag "$@" && { _kit_verb_help harvest; exit 0; }
    _kit_check_target_exists_firstarg harvest 0 "$@" || exit 1
    t="$(_kit_firstarg_resolve "$@")"
    _kit_refuse_on_dispatcher_divergence harvest "$t" "$@" || exit 1
    _kit_firstarg_is_target "$@" && shift
    ( cd "$t" 2>/dev/null || cd "$(pwd)"; exec node "$KIT_DIR/tools/aqe-harvest.cjs" "$@" ) ;;
  embed-sweep)
    _kit_has_help_flag "$@" && { _kit_verb_help embed-sweep; exit 0; }
    _kit_check_target_exists_firstarg embed-sweep 0 "$@" || exit 1
    t="$(_kit_firstarg_resolve "$@")"
    _kit_refuse_on_dispatcher_divergence embed-sweep "$t" "$@" || exit 1
    _kit_firstarg_is_target "$@" && shift
    ( cd "$t" 2>/dev/null || cd "$(pwd)"; exec node "$KIT_DIR/tools/aqe-embed-sweep.cjs" "$@" ) ;;
  version|--version|-v)
    _kit_has_help_flag "$@" && { _kit_verb_help version; exit 0; }
    kit_sha="$(git -C "$KIT_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    kit_date="$(git -C "$KIT_DIR" log -1 --format=%cd --date=short 2>/dev/null || echo '?')"
    echo "ruflo-kit   $kit_sha ($kit_date)   $KIT_DIR"
    if command -v ruflo >/dev/null 2>&1; then
      rv="$(node -p "require('$(npm root -g 2>/dev/null)/ruflo/package.json').version" 2>/dev/null || echo '?')"
      echo "ruflo       $rv (global)"
    else echo "ruflo       not installed (npm i -g ruflo)"; fi
    av="$(node -p "require('$(npm root -g 2>/dev/null)/agentic-qe/package.json').version" 2>/dev/null || echo 'not installed')"
    echo "agentic-qe  $av (global)"
    exit 0 ;;
  self-update)
    _kit_has_help_flag "$@" && { _kit_verb_help self-update; exit 0; }
    [ -d "$KIT_DIR/.git" ] || { echo "ruflo-kit: $KIT_DIR is not a git clone — re-run the installer"; exit 1; }
    echo "Updating kit at $KIT_DIR …"
    # Own exit code from the pull itself — not from whatever the last echo's
    # write happens to return (VERB-SAFETY-V1: a downstream reader closing the
    # pipe early must not make an unrelated trailing echo decide this verb's
    # reported success/failure).
    if git -C "$KIT_DIR" pull --ff-only; then
      echo "Now at $(git -C "$KIT_DIR" rev-parse --short HEAD)."
      _su_rc=0
    else
      _su_rc=1
    fi
    echo "Reminder: after any global ruflo bump, run 'ruflo-kit fix-ruflo <target>' + restart the daemon (see docs Patch 44)."
    exit "$_su_rc" ;;
  "")
    # Bare invocation: lead with a compact status hint (against $(pwd)), then usage.
    if [ -f "$KIT_DIR/lib/status.sh" ]; then
      echo "ruflo-kit — current state ($(pwd)):"
      bash "$KIT_DIR/lib/status.sh" "$(pwd)" --hints 2>/dev/null || true
      echo ""
    fi
    usage
    exit 0 ;;
  help|-h|--help)
    # First-class `help <verb>` form (round 2, B7b): show that verb's own
    # usage block rather than the full command list — and, critically, do
    # this WITHOUT ever touching kit_resolve/a target: "$1" here is looked up
    # purely as a help-topic key, never passed on to any lib/*.sh script.
    v="${1:-}"
    if [[ -n "$v" ]] && _kit_is_known_verb "$v"; then
      _kit_verb_help "$v"
    else
      usage
    fi
    exit 0 ;;
  *) echo "ruflo-kit: unknown command '$cmd'"; echo; usage; exit 1 ;;
esac
